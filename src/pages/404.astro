---
/**
 * src/pages/404.astro
 * 404 error page matching site styling.
 */
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>404 Not Found | AntisocialWorld</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
</head>
<body>
  <div class="stripe" aria-hidden="true"></div>
  <main class="wrap" style="padding-top: 80px; padding-bottom: 80px;">
    <h1>Page not found</h1>
    <p class="lede">The page you were looking for doesn't exist.</p>
    <p><a href="/" class="primary" style="display: inline-block; padding: 11px 20px; border: 2px solid var(--ink); border-radius: 999px; background: var(--ink); color: var(--paper); text-decoration: none; font-weight: 600;">Return home</a></p>
  </main>
  <footer>
    <div class="wrap">
      <p>Solomon Ikharia &#8226; AntisocialWorld</p>
      <p>This site sets no cookies and loads nothing from other sites.</p>
    </div>
  </footer>
</body>
</html>
