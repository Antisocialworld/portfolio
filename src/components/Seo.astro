---
/**
 * src/components/Seo.astro
 * SEO, Open Graph, Twitter Card, and JSON-LD Person structured data per spec J4 & J21.
 */
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "AntisocialWorld, Product Engineer",
  description = "Product engineer building web apps with secure sign-in, payments and background jobs. I check AI-written code before it ships. Case studies, designs and contact.",
  canonicalUrl = "https://antisocialworld.vercel.app/"
} = Astro.props;

const siteUrl = "https://antisocialworld.vercel.app/";
const ogImageUrl = "https://antisocialworld.vercel.app/img/og.png";
const keywords = "AntisocialWorld, Solomon Ikharia, product engineer, Lagos, Nigeria, authentication, payments, background jobs, Next.js, TypeScript, PostgreSQL, UI/UX design, logo design, AI-assisted development, Prisma";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Solomon Ikharia",
  "alternateName": "AntisocialWorld",
  "jobTitle": "Product Engineer",
  "url": "https://antisocialworld.vercel.app/",
  "image": "https://antisocialworld.vercel.app/img/og.png",
  "sameAs": [
    "https://github.com/Antisocialworld",
    "https://www.linkedin.com/in/solomonikharia"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Lagos",
    "addressCountry": "NG"
  },
  "knowsAbout": [
    "Authentication",
    "Payment Systems",
    "Background Job Queues",
    "TypeScript",
    "Next.js",
    "PostgreSQL",
    "UI/UX Design",
    "AI Code Review"
  ]
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content="index,follow" />
<meta name="theme-color" content="#F9F7EB" />
<meta name="color-scheme" content="light" />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="AntisocialWorld, Product Engineer" />
<meta property="og:site_name" content="AntisocialWorld" />
<meta property="og:locale" content="en_NG" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content="AntisocialWorld, Product Engineer" />

<!-- Favicon & Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
