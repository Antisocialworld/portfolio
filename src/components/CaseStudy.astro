---
/**
 * src/components/CaseStudy.astro
 * Case study article component matching reference/artifact-index.html structure.
 */
interface LinkItem {
  text: string;
  href: string;
}

interface Props {
  title: string;
  stack: string;
  problem: string;
  role: string;
  whatBuilt: string;
  keyDecisions: string[];
  result: string;
  links: LinkItem[];
  articleId?: string;
  headingId?: string;
}

const {
  title,
  stack,
  problem,
  role,
  whatBuilt,
  keyDecisions,
  result,
  links,
  articleId,
  headingId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
} = Astro.props;
---
<article class="case" id={articleId} aria-labelledby={headingId}>
  <div>
    <h3 id={headingId}>{title}</h3>
    <p class="stack">{stack}</p>
  </div>
  <dl>
    <div><dt>Problem</dt><dd>{problem}</dd></div>
    <div><dt>My role</dt><dd>{role}</dd></div>
    <div><dt>What I built</dt><dd>{whatBuilt}</dd></div>
    <div><dt>Key decisions</dt>
      <dd><ul>
        {keyDecisions.map(kd => <li>{kd}</li>)}
      </ul></dd></div>
    <div><dt>Result</dt><dd>{result}</dd></div>
    <div><dt>Links</dt><dd class="links">
      {links.map(link => <a href={link.href}>{link.text}</a>)}
    </dd></div>
  </dl>
</article>
